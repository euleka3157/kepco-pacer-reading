s":[{"text":"1번","correct":true,"explanation":""},{"text":"2번","correct":false,"explanation":""},{"text":"3번","correct":false,"explanation":""},{"text":"4번","correct":false,"explanation":""},{"text":"5번","correct":false,"explanation":""}]},{"id":"P090-S1-Q22","number":22,"question":"25.07.13 한국토지주택공사 (트리피) · 객관식 22번","searchText":" 22\n\n의 정상값은?\n\n\n① 0           ② 5\n\n③ 10          ④ 15\n\n⑤ 20","source":{"collection":"2025p2","collectionLabel":"2025 ② (5월~8월)","examLabel":"25.07.13 한국토지주택공사 (트리피)","originalId":"2025p2-e12-m22","number":22},"questionImage":{"src":"data/question-bank/assets/electric/2025p2-e12-m22-q.webp","width":696,"height":567},"explanationImages":[{"src":"data/question-bank/assets/electric/2025p2-e12-m22-e1.webp","width":696,"height":513}],"responseType":"multiple","hint":"","sourceRefs":[],"options":[{"text":"1번","correct":false,"explanation":""},{"text":"2번","correct":false,"explanation":""},{"text":"3번","correct":true,"explanation":""},{"text":"4번","correct":false,"explanation":""},{"text":"5번","correct":false,"explanation":""}]},{"id":"P090-S1-Q23","number":23,"question":"25.07.13 한국토지주택공사 (트리피) · 객관식 23번","searchText":" 23\n\n회로의 해석과 관련된 내용으로 옳은 것은?\n\n\n① KVL은 선형 회로에서만 적용이 가능하다.\n\n② KCL은 비선형 소자가 하나라도 포함되면 적용할 수 없다.\n\n③ 노드해석법에서 각 노드의 전류의 대수합을 0으로 둔다.\n\n④ 중첩의 원리는 비선형 회로에서도 각 독립전원을 개별\n\n  적으로 분석하여 결과를 합하는 형태로 적용가능하다.\n\n⑤ 루프해석에서 개의 독립된 루프에 대해 개의\n\n   KVL 방정식을 적용한다.","source":{"collection":"2025p2","collectionLabel":"2025 ② (5월~8월)","examLabel":"25.07.13 한국토지주택공사 (트리피)","originalId":"2025p2-e12-m23","number":23},"questionImage":{"src":"data/question-bank/assets/electric/2025p2-e12-m23-q.webp","width":696,"height":723},"explanationImages":[{"src":"data/question-bank/assets/electric/2025p2-e12-m23-e1.webp","width":696,"height":501}],"responseType":"multiple","hint":"","sourceRefs":[],"options":[{"text":"1번","correct":false,"explanation":""},{"text":"2번","correct":false,"explanation":""},{"text":"3번","correct":true,"explanation":""},{"text":"4번","correct":false,"explanation":""},{"text":"5번","correct":false,"explanation":""}]},{"id":"P090-S1-Q24","number":24,"question":"25.07.13 한국토지주택공사 (트리피) · 객관식 24번","searchText":" 24\n\nsin°의 라플라스 변환은?\n\n              \n①            ② \n               \n③            ④ \n   \n⑤","source":{"collection":"2025p2","collectionLabel":"2025 ② (5월~8월)","examLabel":"25.07.13 한국토지주택공사 (트리피)","originalId":"2025p2-e12-m24","number":24},"questionImage":{"src":"data/question-bank/assets/electric/2025p2-e12-m24-q.webp","width":696,"height":593},"explanationImages":[{"src":"data/question-bank/assets/electric/2025p2-e12-m24-e1.webp","width":678,"height":1881}],"responseType":"multiple","hint":"","sourceRefs":[],"options":[{"text":"1번","correct":false,"explanation":""},{"text":"2번","correct":false,"explanation":""},{"text":"3번","correct":false,"explanation":""},{"text":"4번","correct":false,"explanation":""},{"text":"5번","correct":true,"explanation":""}]},{"id":"P090-S1-Q25","number":25,"question":"25.07.13 한국토지주택공사 (트리피) · 객관식 25번","searchText":" 25\n\n특성방정식이 인 시스템이 안정하기\n\n위한 의 범위는?\n\n\n①          ② \n\n③       ④ \n\n⑤ ","source":{"collection":"2025p2","collectionLabel":"2025 ② (5월~8월)","examLabel":"25.07.13 한국토지주택공사 (트리피)","originalId":"2025p2-e12-m25","number":25},"questionImage":{"src":"data/question-bank/assets/electric/2025p2-e12-m25-q.webp","width":678,"height":647},"explanationImages":[{"src":"data/question-bank/assets/electric/2025p2-e12-m25-e1.webp","width":696,"height":1406}],"responseType":"multiple","hint":"","sourceRefs":[],"options":[{"text":"1번","correct":false,"explanation":""},{"text":"2번","correct":true,"explanation":""},{"text":"3번","correct":false,"explanation":""},{"text":"4번","correct":false,"explanation":""},{"text":"5번","correct":false,"explanation":""}]}]}
