th":696,"height":533},"explanationImages":[{"src":"data/question-bank/assets/electric/2024h2-e19-m04-e1.webp","width":678,"height":1263}],"responseType":"multiple","hint":"","sourceRefs":[],"options":[{"text":"1번","correct":true,"explanation":""},{"text":"2번","correct":false,"explanation":""},{"text":"3번","correct":false,"explanation":""},{"text":"4번","correct":false,"explanation":""},{"text":"5번","correct":false,"explanation":""}]},{"id":"P060-S1-Q05","number":5,"question":"24.10.19 한국철도공사(차량/운전) (한국사회능력개발원) · 객관식 5번","searchText":" 05\n\n평행한 두 개의 무한직선도체에 동일한 방향으로 전류가\n\n흐를 때, 두 도체간에 작용하는 단위 길이당 힘Nm과\n\n작용력의 종류는 어떻게 되는가?\n\n\n    단위 길이당 힘N      작용력\n                 \n ①                 흡입력  \n                 \n ②                 반발력  \n               \n ③                 흡입력  \n                 \n ④                 흡입력  \n                 \n ⑤                 반발력  ","source":{"collection":"2024h2","collectionLabel":"2024 하반기","examLabel":"24.10.19 한국철도공사(차량/운전) (한국사회능력개발원)","originalId":"2024h2-e19-m05","number":5},"questionImage":{"src":"data/question-bank/assets/electric/2024h2-e19-m05-q.webp","width":696,"height":716},"explanationImages":[{"src":"data/question-bank/assets/electric/2024h2-e19-m05-e1.webp","width":678,"height":619}],"responseType":"multiple","hint":"","sourceRefs":[],"options":[{"text":"1번","correct":false,"explanation":""},{"text":"2번","correct":false,"explanation":""},{"text":"3번","correct":false,"explanation":""},{"text":"4번","correct":true,"explanation":""},{"text":"5번","correct":false,"explanation":""}]},{"id":"P060-S1-Q06","number":6,"question":"24.10.19 한국철도공사(차량/운전) (한국사회능력개발원) · 객관식 6번","searchText":" 06\n\n다음의 히스테리시스 곡선에 대한 설명으로 옳지 않은\n\n것은?\n\n\n\n\n\n① 은 잔류자기이다.\n\n② 은 보자력이다.\n\n③ 히스테리시스 손실은 부하손 중 동손이다.\n\n④ 영구자석은 ,  모두 커야한다.\n\n⑤ 전자석은 이 크고, 이 작고, 히스테리시스 면적이\n\n  작아야 한다.","source":{"collection":"2024h2","collectionLabel":"2024 하반기","examLabel":"24.10.19 한국철도공사(차량/운전) (한국사회능력개발원)","originalId":"2024h2-e19-m06","number":6},"questionImage":{"src":"data/question-bank/assets/electric/2024h2-e19-m06-q.webp","width":678,"height":1075},"explanationImages":[{"src":"data/question-bank/assets/electric/2024h2-e19-m06-e1.webp","width":696,"height":1881}],"responseType":"multiple","hint":"","sourceRefs":[],"options":[{"text":"1번","correct":false,"explanation":""},{"text":"2번","correct":false,"explanation":""},{"text":"3번","correct":true,"explanation":""},{"text":"4번","correct":false,"explanation":""},{"text":"5번","correct":false,"explanation":""}]},{"id":"P060-S1-Q07","number":7,"question":"24.10.19 한국철도공사(차량/운전) (한국사회능력개발원) · 객관식 7번","searchText":" 07\n\n다음과 같은 회로에서 와 사이의 전압이 20V라면,\n와 사이의 전압 는 몇 V인가?\n\n\n\n\n\n① 32          ② 38\n\n③ 42          ④ 48\n\n⑤ 56","source":{"collection":"2024h2","collectionLabel":"2024 하반기","examLabel":"24.10.19 한국철도공사(차량/운전) (한국사회능력개발원)","originalId":"2024h2-e19-m07","number":7},"questionImage":{"src":"data/question-bank/assets/electric/2024h2-e19-m07-q.webp","width":678,"height":807},"explanationImages":[{"src":"data/question-bank/assets/electric/2024h2-e19-m07-e1.webp","width":678,"height":854}],"responseType":"multiple","hint":"","sourceRefs":[],"options":[{"text":"1번","correct":false,"explanation":""},{"text":"2번","correct":false,"explanation":""},{"text":"3번","correct":false,"explanation":""},{"text":"4번","correct":false,"explanation":""},{"text":"5번","correct":true,"explanation":""}]},{"id":"P060-S1-Q08","number":8,"question":"24.10.19 한국철도공사(차량/운전) (한국사회능력개발원) · 객관식 8번","searchText":" 08\n\n다음과 같은 회로에서, 전류 는 몇 A 인가?\n\n\n\n\n\n① 2           ② 3\n\n③ 4           ④ 5\n\n⑤ 6","source":{"collection":"2024h2","collectionLabel":"2024 하반기","examLabel":"24.10.19 한국철도공사(차량/운전) (한국사회능력개발원)","originalId":"2024h2-e19-m08","number":8},"questionImage":{"src":"data/question-bank/assets/electric/2024h2-e19-m08-q.webp","width":696,"height":896},"explanationImages":[{"src":"data/question-bank/assets/electric/